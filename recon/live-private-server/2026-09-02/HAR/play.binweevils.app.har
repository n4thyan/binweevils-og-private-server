-block {\r\n\tbackground: #333;\r\n}\r\n\r\nbody.dark .reg-block-header {\r\n\tborder-bottom-color: #555;\r\n}\r\n\r\n/*Background Light Color\r\n------------------------------------*/\r\nbody.dark .bg-color-light {\r\n\tbackground: #252525 !important;\r\n}\r\n\r\n/*Icon Pages\r\n------------------------------------*/\r\nbody.dark .icon-page-fa .item i,\r\nbody.dark .demo-pro-glyphicons span:before {\r\n\tcolor: #999;\r\n}\r\n\r\n/*Portfolio Pages\r\n------------------------------------*/\r\nbody.dark .fusion-portfolio #filters-container .cbp-filter-item {\r\n\tcolor: #999;\r\n\tborder-color: #555;\r\n}\r\n\r\nbody.dark .fusion-portfolio #filters-container .cbp-filter-item:hover {\r\n\tcolor: #ccc;\r\n}\r\n\r\nbody.dark .fusion-portfolio .cbp-l-caption-desc, \r\nbody.dark .fusion-portfolio .product-description span {\r\n\tcolor: #555;\r\n}\r\n\r\n/*Portfolio 2 Column (Old)*/\r\nbody.dark .view-tenth:hover p {\r\n\tcolor: #ccc;\r\n}\r\n\r\n/*Blog Masonry Page\r\n------------------------------------*/\r\nbody.dark .blog_masonry_3col .grid-boxes-in {\r\n\tborder-color: #555;\r\n}\r\n\r\nbody.dark .blog_masonry_3col h3 a {\r\n\tcolor: #999;\r\n}\r\n\r\nbody.dark .grid-boxes-caption.grid-boxes-quote p {\r\n\tcolor: #fff;\r\n}\r\n\r\n/*News v1\r\n------------------------------------*/\r\nbody.dark .news-v1-in.bg-color-white {\r\n\tbackground-color: #333 !important;\r\n}\r\n\r\nbody.dark .news-v1 .news-v1-info {\r\n\tborder-top-color: #777;\r\n}\r\n\r\n/*News v2\r\n------------------------------------*/\r\nbody.dark .news-v2 .news-v2-badge p {\r\n\tbackground: #555;\r\n}\r\n\r\nbody.dark .news-v2 .news-v2-badge span,\r\nbody.dark .news-v2 .news-v2-badge small {\r\n\tcolor: #ccc;\r\n}\r\n\r\nbody.dark .news-v2 .news-v2-desc {\r\n\tbackground: #333;\r\n}\r\n\r\nbody.dark .news-v2 .news-v2-desc h3 a {\r\n\tcolor: #ccc;\r\n}\r\n\r\nbody.dark .news-v2 .news-v2-desc h3 a:hover {\r\n\tcolor: #72c02c;\r\n}\r\n\r\nbody.dark .news-v2 .news-v2-desc small,\r\nbody.dark .news-v2 .news-v2-desc p {\r\n\tcolor: #999;\r\n}\r\n\r\n/*News v3\r\n------------------------------------*/\r\nbody.dark .news-v3 {\r\n\tbackground: #252525;\r\n}\r\nbody.dark .news-v3 .news-v3-in {\r\n\tbackground: #333;\r\n}\r\n\r\nbody.dark .news-v3 h2 a {\r\n\tcolor: #ccc;\r\n}\r\n\r\nbody.dark .news-v3 h2 a:hover {\r\n\tcolor: #72c02c;\r\n}\r\n\r\nbody.dark .news-v3 .posted-info li,\r\nbody.dark .news-v3 .posted-info li a {\r\n\tcolor: #999;\r\n}\r\n\r\nbody.dark .news-v3 .posted-info li a:hover {\r\n\tcolor: #72c02c;\r\n}\r\n\r\n/*Post Shares*/\r\nbody.dark .news-v3 .post-shares li i {\r\n\tbackground: #bbb;\r\n}\r\n\r\nbody.dark .news-v3 .post-shares li i:hover {\r\n  \tbackground: #ddd;\r\n}\r\n\r\nbody.dark .news-v3 .post-shares li span {\r\n\tborder-color: #bbb;\r\n}\r\n\r\n/*Blog Authore\r\n------------------------------------*/\r\nbody.dark .blog-author {\r\n\tbackground: #333;\r\n}\r\n\r\n/*Blog Comments\r\n------------------------------------*/\r\nbody.dark .blog-comments .comments-itself {\r\n\tbackground: #333;\r\n}\r\n\r\nbody.dark .blog-comments .comments-itself:before {\r\n\tborder-color: transparent #333 transparent transparent;\r\n}\r\n\r\nbody.dark .blog-comments .comments-itself span {\r\n\tcolor: #999;\r\n}\r\n\r\nbody.dark .sky-form.comment-style fieldset {\r\n\tbackground: inherit;\r\n}\r\n\r\n/*Blog Latest Posts\r\n------------------------------------*/\r\nbody.dark .blog-latest-posts li {\r\n\tborder-top-color: #777;\r\n}\r\n\r\nbody.dark .blog-latest-posts h3 a:hover {\r\n\tcolor: #72c02c;\r\n}\r\n\r\n/*Blog Trending\r\n------------------------------------*/\r\nbody.dark .blog-trending h3 a:hover {\r\n\tcolor: #72c02c;\r\n}\r\n\r\n/*Blog Post Quote\r\n------------------------------------*/\r\nbody.dark .blog-post-quote {\r\n\tbackground: #333;\r\n}\r\n\r\nbody.dark .blog-post-quote p {\r\n\tcolor: #ccc;\r\n}\r\n\r\nbody.dark .blog-post-quote span {\r\n\tcolor: #999;\r\n}\r\n\r\n/*Parallax Quote\r\n------------------------------------*/\r\nbody.dark .parallax-quote-light .parallax-quote-in {\r\n\tbackground: #333;\r\n}\r\n\r\n/*Cube Portfolio\r\n------------------------------------*/\r\nbody.dark .cube-portfolio .cbp-l-inline {\r\n\tbackground: #333;\r\n}\r\n\r\nbody.dark .cube-portfolio .cbp-l-inline-title {\r\n\tcolor: #ccc;\r\n}\r\n\r\nbody.dark .cube-portfolio .cbp-l-inline-desc {\r\n\tcolor: #999;\r\n}\r\n\r\nbody.dark .cube-portfolio .cbp-title-dark .cbp-l-grid-agency-title {\r\n\tcolor: #ccc !important;\r\n}\r\n\r\nbody.dark .cube-portfolio .cbp-title-dark .cbp-l-grid-agency-desc {\r\n\tcolor: #999 !important;\r\n}\r\n\r\n/*Call To Action\r\n------------------------------------*/\r\nbody.dark .call-action-v2 {\r\n\tbackground: #333;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n/* Add here all your css styles (customizations) */\r\ndiv#container-content h1, h2, h3, h4, h5, h6,\r\ndiv#container-content-play h1, h2, h3, h4, h5, h6 {\r\n    font-family: 'Fredoka One', cursive;\r\n}\r\n#container-content,\r\n#container-content-play{\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 16px;\r\n}\r\n.posts .dl-horizontal dd a{\r\n    font-size: 16px;\r\n}\r\n.news-v3 h2 {\r\n    text-transform: none;\r\n}\r\n.news-v3{\r\n    position: relative;\r\n}\r\n.footer-v1 .footer{\r\n    background: #69b22c;\r\n    padding: 10px 0;\r\n}\r\n\r\n#footer-links li{\r\n    display: inline-block;\r\n    padding-top: 7px;\r\n}\r\n#footer-links a{\r\n    color: white;\r\n    font-family: 'Nunito', sans-serif;\r\n    font-weight: bold;\r\n    font-size: 16px;\r\n}\r\n#footer-links a:hover{\r\n    color: white;\r\n    text-decoration: underline;\r\n}\r\n#footer-links a.footer-ltd{\r\n    font-size: 13px;\r\n    font-weight: normal;\r\n    cursor: default;\r\n}\r\n#footer-links a.footer-ltd:hover{\r\n    text-decoration: none;\r\n}\r\n.mini-menu{\r\n    padding: 0 0 10px 0;\r\n    text-align: center;\r\n}\r\n.mini-menu a{\r\n    text-decoration: none;\r\n}\r\n.mini-menu img{\r\n    margin-right: -5px;\r\n    padding-right: 2px;\r\n}\r\n.button-comments-count,\r\n.button-likes-count{\r\n    display: inline-block;\r\n    -webkit-background-size: 100% auto;\r\n    background-size: 100% auto;\r\n    position: relative;\r\n    cursor: pointer;\r\n}\r\n.button-comments-count-small{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/blog_comment_white.png\") no-repeat;\r\n    width: 33px;\r\n    height: 30px;\r\n}\r\n\r\n.button-comments-count-big{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/blog_comment_white_big.png\") no-repeat;\r\n    width: 43px;\r\n    height: 39px;\r\n    margin-left: 15px;\r\n}\r\n.button-likes-count-small{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/blog_like_white.png\") no-repeat;\r\n    width: 33px;\r\n    height: 30px;\r\n}\r\n.button-likes-count-white{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/blog_like_white.png\");\r\n    width: 33px;\r\n    height: 30px;\r\n}\r\n.button-likes-count-white-big{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/blog_like_white_big.png\");\r\n    width: 43px;\r\n    height: 39px;\r\n    margin-left: 15px;\r\n}\r\n\r\n.button-likes-count-white.liked{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/blog_like_green.png\");\r\n    width: 33px;\r\n    height: 30px;\r\n}\r\n.button-likes-count-white-big.liked{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/blog_like_green_big.png\");\r\n    width: 43px;\r\n    height: 39px;\r\n    margin-left: 15px;\r\n}\r\n.count-button:hover{text-decoration: none}\r\n.count-button-active span{\r\n    color: white;\r\n\r\n    font-family: 'Nunito', sans-serif;\r\n    display: block;\r\n    font-weight: bold;\r\n    position: absolute;\r\n    text-align: center;\r\n    width: 100%;\r\n}\r\n.count-button span{\r\n    color: darkgreen;\r\n\r\n    font-family: 'Nunito', sans-serif;\r\n    display: block;\r\n    font-weight: bold;\r\n    position: absolute;\r\n    text-align: center;\r\n    width: 100%;\r\n}\r\n.count-button-small span{\r\n    font-size: 17px;\r\n    top: 1px;\r\n}\r\n.count-button-big span{\r\n    font-size: 17px;\r\n    top: 5px;\r\n}\r\n.read-more-btn{\r\n    display: inline-block;\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/btn_readmore_orange.png\") no-repeat;\r\n    -webkit-background-size: 100% auto;\r\n    background-size: 100% auto;\r\n    width: 95px;\r\n    height: 30px;\r\n    position: relative;\r\n}\r\n.blog-comments img{\r\n    width: auto;\r\n    height: auto;\r\n}\r\n.blog-comment-icon-level{\r\n    display: inline-block;\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/blog_comment_icon_level.png\") no-repeat;\r\n    -webkit-background-size: 100% auto;\r\n    background-size: 100% auto;\r\n    width: 33px;\r\n    height: 33px;\r\n    position: relative;\r\n}\r\n.blog-comment-icon-level span{\r\n    color: brown;\r\n    font-family: 'Nunito', sans-serif;\r\n    display: block;\r\n    font-size: 14px;\r\n    font-weight: bold;\r\n    position: absolute;\r\n    text-align: center;\r\n    top: 5px;\r\n    width: 100%;\r\n}\r\n#sidebar-recent-posts .blog-post-bg{\r\n    position: relative;\r\n}\r\n#sidebar-recent-posts .blog-post-text{\r\n    position: absolute;\r\n    top: 14px;\r\n    left: 120px;\r\n    font-family: \"Fredoka One\",cursive;\r\n    color: #373b41;\r\n    font-size: 15px;\r\n    line-height: 1.5;\r\n}\r\n#sidebar-recent-posts .blog-post-text p{\r\n    max-height: 67px;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n}\r\n#sidebar-recent-posts .blog-post-image{\r\n    position: absolute;\r\n    top: 16px;\r\n    left: 4px;\r\n}\r\n#sidebar-recent-posts .blog-post-image img{\r\n    height: 64px;\r\n}\r\n#sidebar-recent-posts .blog-post-image a:hover,\r\n#sidebar-recent-posts .blog-post-text a:hover{\r\n    text-decoration: none;\r\n}\r\n@media all and (max-width: 1199px){\r\n    #sidebar-recent-posts .blog-post-image{\r\n        top: 11px;\r\n        left: 0;\r\n    }\r\n    #sidebar-recent-posts .blog-post-image img{\r\n        height: 55px;\r\n    }\r\n    #sidebar-recent-posts .blog-post-text{\r\n        top: 10px;\r\n        left: 99px;\r\n    }\r\n    #sidebar-recent-posts .blog-post-text p{\r\n        max-height: 57px;\r\n        font-size: 13px;\r\n    }\r\n}\r\ndiv.comment-block{\r\n    background-color: rgba(220, 242, 253, 0.71);\r\n    margin-left: 32px;\r\n    margin-right: 32px;\r\n    padding: 20px 20px 32px 20px;\r\n    border-radius: 5px;\r\n}\r\n.login-alert{\r\n    margin-left: 17px;\r\n    margin-right: 17px;\r\n}\r\ndiv.comment-content{\r\n    padding-left: 0;\r\n    padding-right: 0;\r\n}\r\n.small-comment-block{\r\n    display: inline;\r\n    padding-left: 12px;\r\n}\r\n#comment-form-container{\r\n    margin-top: 20px;\r\n    margin-bottom: 30px;\r\n}\r\n.main-comment-form{\r\n    margin-top: 40px;\r\n    margin-left: 16px;\r\n    margin-right: 16px;\r\n}\r\n.comment-form-container form{\r\n    margin: 15px 30px 0;\r\n}\r\n.blog-comments .comment-block p {\r\n    margin: 0;\r\n}\r\n.blog-comments .row{\r\n    margin-bottom: 15px;\r\n}\r\ndiv.children-container{\r\n    padding: 0 0 0 40px;\r\n}\r\nsection.reference-section{\r\n    margin-bottom: 0;\r\n}\r\n.comment-reply-btn{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/main-btns/reply1.png\") no-repeat;\r\n    -webkit-background-size: 100% auto;\r\n    background-size: 100% auto;\r\n    width: 54px;\r\n    height: 35px;\r\n}\r\n.cancelButton:hover{\r\n    text-decoration: none;\r\n}\r\n.cancelButton{\r\n    font-size: 14px;\r\n}\r\ndiv.blog-category p{\r\n    vertical-align: middle;\r\n}\r\ndiv#sidebar-categories .blog-category p{\r\n    margin: -4px 0 10px;\r\n}\r\n.wrapper{\r\n    background: #68B500 url('https://play.binweevils.app/assets/game/images/repeatBG.jpg') repeat-x scroll center top;\r\n    overflow: hidden;\r\n}\r\n.container{\r\n    position: relative;\r\n    padding-top: 0;\r\n}\r\n\r\n@media all and (min-width: 1900px){\r\n    .under-container-content{\r\n        margin: 0 18%;\r\n    }\r\n}\r\n#container-content{\r\n    background: white;\r\n    position: relative;\r\n    padding: 15px;\r\n    border-radius: 5px 5px 0 0;\r\n}\r\n#container-header{\r\n    /*background-color: #4c3b65;*/\r\n}\r\n.header{\r\n    height: 110px;\r\n    background: transparent;\r\n}\r\n.lateral-background{\r\n    position: absolute;\r\n    width: 370px;\r\n    height: 1225px;\r\n    top: -160px;\r\n}\r\n#bg-left-side{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/bg_left_side.png\");\r\n    left: -370px;\r\n}\r\n#bg-right-side{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/bg_right_side.png\");\r\n    right: -370px;\r\n}\r\n#bg-left-side-play{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/bg_left_side_play.png\");\r\n    left: -368px;\r\n}\r\n#bg-right-side-play{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/bg_right_side_play.png\");\r\n    right: -369px;\r\n}\r\n.blog-post-container{\r\n    padding: 10px 5px;\r\n    border: 2px solid lightgrey;\r\n    border-radius: 5px;\r\n    margin: 0;\r\n}\r\n.cat-icons-container{\r\n    display: inline-block;\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n}\r\n.cat-icon{\r\n    display: inline-block;\r\n    -webkit-background-size: 100% auto;\r\n    background-size: 100% auto;\r\n    width: 35px;\r\n    height: 35px;\r\n}\r\n.cat-icon-1{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_bestnest.png\") no-repeat;\r\n}\r\n.cat-icon-6{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_codes.png\") no-repeat;\r\n}\r\n.cat-icon-9{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_competitions.png\") no-repeat;\r\n}\r\n.cat-icon-18{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_videos.png\") no-repeat;\r\n}\r\n.cat-icon-24{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_vip.png\") no-repeat;\r\n}\r\n.cat-icon-32{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_news.png\") no-repeat;\r\n}\r\n.cat-icon-33{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_fanart.png\") no-repeat;\r\n}\r\n.cat-icon-46{\r\n    background: url(\"https://play.binweevils.app/assets/img/blog/categories-icons/cat_icon_gotw.png\") no-repeat;\r\n}\r\n.rounded-form{\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 17px;\r\n    border: 2px solid lightgrey;\r\n    border-radius: 5px;\r\n}\r\n.rounded-form header,\r\n.rounded-form footer{\r\n    background: none;\r\n}\r\n.rounded-form .select select,\r\n.rounded-form .input input,\r\n.rounded-form .checkbox,\r\n.rounded-form .textarea textarea{\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 17px;\r\n    font-weight: lighter;\r\n    color: grey;\r\n}\r\n.rounded-form .select select{\r\n    height: 42px;\r\n}\r\n.rounded-form .select i{\r\n    top: 18px;\r\n}\r\n.news-v3 .news-v3-in{\r\n    padding-top: 0;\r\n}\r\n.intro{\r\n    font-size: 16px;\r\n    margin-bottom: 20px;\r\n}\r\n.img-front{\r\n    position: absolute;\r\n    z-index: 2;\r\n    top: 23px;\r\n    left: 15px;\r\n}\r\n.img-back{\r\n    position: relative;\r\n    vertical-align: middle;\r\n    margin: 23px 0;\r\n}\r\n.header{\r\n    border-bottom: 0;\r\n}\r\n.nav-bar{\r\n    height: 110px;\r\n    margin-bottom: 0;\r\n}\r\n.nav-bar a:hover{\r\n    text-decoration: none;\r\n}\r\n.nav-bar .logo{\r\n    max-width: 140px;\r\n    position: absolute;\r\n    top: 8px;\r\n    margin: 0;\r\n}\r\n.nav-center{\r\n    position: relative;\r\n    display: inline-block;\r\n    top: 23px;\r\n    left: 6px;\r\n}\r\n.nav-green-bg{\r\n    position: absolute;\r\n}\r\n.nav-icons{\r\n    position: absolute;\r\n    top: -5px;\r\n    left: 0;\r\n}\r\n.nav-icons a{\r\n    padding-left: 30px;\r\n}\r\n.nav-arrow{\r\n    position: absolute;\r\n    left: 228px;\r\n    top: 46px;\r\n    z-index: 2;\r\n}\r\n.nav-center-medium{\r\n    position: relative;\r\n    display: inline-block;\r\n    top: 23px;\r\n    left: -14px;\r\n}\r\n.nav-center-medium-play{\r\n    position: relative;\r\n    top: 23px;\r\n    left: -14px;\r\n}\r\n.nav-green-bg-medium{\r\n    position: absolute;\r\n    left: 265px;\r\n}\r\n.nav-icons-medium{\r\n    position: absolute;\r\n    top: -1px;\r\n    left: 265px;\r\n}\r\n.nav-icons-medium-play{\r\n    position: absolute;\r\n    top: 0;\r\n    left: -64px;\r\n}\r\n.nav-arrow-medium{\r\n    position: absolute;\r\n    left: 415px;\r\n    top: 50px;\r\n    z-index: 2;\r\n}\r\n.nav-right-login{\r\n    position: absolute;\r\n    top: 16px;\r\n    right: 35px;\r\n}\r\n\r\n.nav-weevil-name,\r\n.nav-sign-out,\r\n.nav-manage{\r\n    position: absolute;\r\n    font-family: 'McLaren', cursive;\r\n}\r\n\r\n.nav-weevil-name{\r\n    font-size: 19px;\r\n    color: white;\r\n}\r\n.nav-sign-out{\r\n    font-size: 16px;\r\n    color: darkgreen;\r\n    top: 45px;\r\n}\r\n.nav-manage{\r\n    font-size: 16px;\r\n    color: darkgreen;\r\n    top: 22px;\r\n}\r\n.nav-sign-out:hover,\r\n.nav-manage:hover{\r\n    color: #2c7b04;\r\n}\r\n.small-icons{\r\n    max-width: 16px;\r\n}\r\n@media all and (max-width: 1199px){\r\n    .nav-center{\r\n        display: none;\r\n    }\r\n}\r\n.sidebar-polls{\r\n    background-color: #39aaff;\r\n    border-left: 2px #2293ff solid;\r\n    border-right: 2px #2293ff solid;\r\n    padding: 0 7px;\r\n}\r\n.poll-container,\r\n.poll-results{\r\n    background-color: white;\r\n}\r\n.img-bottom{\r\n    margin-top: -5px;\r\n}\r\n.poll-form{\r\n    padding: 20px;\r\n    margin-bottom: 5px;\r\n    border: 3px #93d0ff solid;\r\n    border-radius: 20px;\r\n}\r\n.poll-form footer{\r\n    margin-top: 10px;\r\n}\r\n.poll-form footer a{\r\n    cursor: pointer;\r\n}\r\n.poll-question{\r\n    font-size: 17px;\r\n}\r\n.poll-form .radio,\r\n.poll-form .checkbox,\r\n.poll-form .answer{\r\n    font-size: 14px;\r\n    font-weight: 400;\r\n    color: grey;\r\n}\r\n.poll-form .radio,\r\n.poll-form .checkbox{\r\n    margin-left: 20px;\r\n}\r\n.poll-form .checkbox input{\r\n    margin-top: 7px;\r\n}\r\n.poll-form .radio input{\r\n    margin-top: 5px;\r\n}\r\n.login-bg{\r\n    background: #999;\r\n    position: fixed;\r\n    width: 100%;\r\n    height: 100%;\r\n}\r\n.login-window{\r\n    position: relative;\r\n    top: 50%;\r\n    height: 292px;\r\n    max-width: 320px;\r\n    margin: -146px auto;\r\n}\r\n.login-window a{\r\n    position: absolute;\r\n    font-family: 'McLaren', cursive;\r\n}\r\n#login-form input{\r\n    background: transparent;\r\n    border: none;\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 19px;\r\n}\r\n#login-form input:hover{\r\n    border: none;\r\n}\r\n.login-window a:hover{\r\n    text-decoration: none;\r\n}\r\n.login-window .close-x{\r\n    top: 0;\r\n    right: 0;\r\n}\r\n.login-window .login-heading{\r\n    cursor: default;\r\n    color: white;\r\n    top: 13px;\r\n    left: 45px;\r\n}\r\n#login-form .login-label{\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 13px;\r\n    font-weight: 400;\r\n    color: darkblue;\r\n}\r\n#login-form .name,\r\n#login-form .name-label,\r\n#login-form .password,\r\n#login-form .password-label{\r\n    position: absolute;\r\n    left: 65px;\r\n}\r\n#login-form .name,\r\n#login-form .password{\r\n    width: 190px;\r\n}\r\n#login-form .name{\r\n    top: 64px;\r\n}\r\n#login-form .name-label{\r\n    top: 47px;\r\n}\r\n#login-form .password{\r\n    top: 114px;\r\n}\r\n#login-form .password-label{\r\n    top: 98px;\r\n}\r\n#login-form .login-btn{\r\n    top: 195px;\r\n    left: 107px;\r\n}\r\n#login-form .forgot{\r\n    top: 144px;\r\n    left: 85px;\r\n}\r\n#login-form .forgot:hover p{\r\n    color: