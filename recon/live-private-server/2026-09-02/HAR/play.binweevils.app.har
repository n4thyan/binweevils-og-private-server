 {\r\n    margin-top: 10px;\r\n    margin-left: 1px;\r\n}\r\n.registration-input {\r\n    position: absolute;\r\n    font-size: 20px;\r\n    width: 300px;\r\n    padding: 8px 45px 8px 8px;\r\n    border-radius: 10px;\r\n    border: solid 3px #2CAAD7;\r\n    background-color: #ecf7ff;\r\n}\r\n.top-input {\r\n    top: 200px;\r\n    right: 195px;\r\n}\r\n.bottom-input {\r\n    top: 310px;\r\n    right: 195px;\r\n}\r\n\r\n.label-username {\r\n    top: 171px;\r\n    left: 445px;\r\n}\r\n.label-password {\r\n    top: 282px;\r\n    left: 445px;\r\n}\r\n.green-button {\r\n    position: absolute;\r\n}\r\n.button-random {\r\n    top: 204px;\r\n    right: 55px;\r\n}\r\n.button-show,\r\n.button-hide {\r\n    top: 314px;\r\n    right: 70px;\r\n}\r\n.button-show {\r\n    display: none;\r\n}\r\n.button-show:hover,\r\n.button-hide:hover {\r\n    cursor: pointer;\r\n}\r\n.button-play {\r\n    top: 420px;\r\n    right: 160px;\r\n}\r\n.icon-hidden {\r\n    display: none;\r\n}\r\n.icon-username {\r\n    position: absolute;\r\n    top: 203px;\r\n    right: 198px;\r\n}\r\n.icon-password {\r\n    position: absolute;\r\n    top: 313px;\r\n    right: 198px;\r\n}\r\n.span {\r\n    display: none;\r\n    position: absolute;\r\n    font-weight: bolder;\r\n    font-size: 14px;\r\n    color: red;\r\n}\r\n.span-username {\r\n    top: 253px;\r\n}\r\n.span-password {\r\n    top: 363px;\r\n}\r\n.be-safe {\r\n    position: absolute;\r\n    top: 254px;\r\n    right: 223px;\r\n    color: darkblue;\r\n    font-weight: bolder;\r\n    font-size: 14px;\r\n}\r\n#span-username-error {\r\n    right: 127px;\r\n\r\n    width: 368px;\r\n}\r\n.invalid-password {\r\n    right: 260px;\r\n}\r\n.four-or-more {\r\n    right: 187px;\r\n}\r\n.sixteen-or-less,\r\n.different {\r\n    right: 205px;\r\n}\r\n.three-or-more,\r\n.fifteen-or-less {\r\n    right: 174px;\r\n}\r\n#error-username {\r\n    top: 208px;\r\n    right: 200px;\r\n}\r\n#error-password {\r\n    top: 318px;\r\n    right: 200px;\r\n}\r\n#play-green {\r\n    display: none;\r\n}\r\n#errors,\r\n#alternatives {\r\n    display: none;\r\n    padding: 12px;\r\n    background-color: white;\r\n    border-radius: 10px;\r\n    width: 200px;\r\n    text-align: center;\r\n    border: 5px solid red;\r\n    position: absolute;\r\n    top: 38px;\r\n    right: 155px;\r\n}\r\n.select-username:hover {\r\n    cursor: pointer;\r\n}\r\n.register-text-container{\r\n    position: relative;\r\n}\r\n.register-text{\r\n    position: relative;\r\n    background-color: #9eddf9;\r\n    border-radius: 15px;\r\n    border: solid darkgreen 10px;\r\n    padding: 25px;\r\n    z-index: 1;\r\n}\r\n.register-text p{\r\n    text-align: justify;\r\n}\r\n.padding-top-40{\r\n    padding-top: 40px;\r\n}\r\n.hide-corners{\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 20px;\r\n}\r\n.hide-corners-light{\r\n    top: 0;\r\n    background-color: #5ec62c;\r\n}\r\n.hide-corners-dark{\r\n    bottom: 0;\r\n    background-color: #2c7b04;\r\n}\r\n.body_affiliate{\r\n    background-position:0 140px;\r\n}\r\n#affiliateheader{\r\n    background-color:#91BAE6;\r\n    padding-bottom:10px; /* latest firefox doesn't inherit so repeat here */\r\n}\r\n.nav-green-bg-medium-play{\r\n    position: absolute;\r\n    top: 0;\r\n    left: -65px;\r\n}\r\n.input-submit{\r\n    visibility: hidden;\r\n    position: absolute;\r\n    top: 0;\r\n}\r\n.play-body{\r\n    background-color: #69b22c;\r\n}\r\n.contact-us-btn-container{\r\n    padding: 25px;\r\n}\r\n/** First passage to smaller size **/\r\n@media only screen and (max-width: 990px) {\r\n    .nav-bar .logo {\r\n        display: none;\r\n    }\r\n\r\n    /* smaller header */\r\n    .header{\r\n        height:55px;\r\n    }\r\n    .toggle-menu-button {\r\n        margin-top:9px;\r\n    }\r\n}\r\n\r\n/** only white column visible */\r\n@media only screen and (max-width: 770px) {\r\n    /* Remove border radius when minimized */\r\n    #container-content {\r\n        border-radius: 0;\r\n    }\r\n}\r\n\r\n/* fix for overlapping labels in forgot pass */\r\n#forgot_pass label,\r\n#create_new_pass label\r\n{\r\n    position: relative;\r\n}\r\n\r\n/*navigation menu*/\r\n.nav-right-login-www{\r\n    position: absolute;\r\n    top: 16px;\r\n    right: 30px;\r\n}\r\n#esi-block-login {\r\n    width: 270px;\r\n    height:78px;\r\n    position: relative;\r\n}\r\n#esi-block-login .nav-nest{\r\n    position: absolute;\r\n    left:0;\r\n    width: 74px;\r\n    height: 74px;\r\n}\r\n#esi-block-login .logged-in-container{\r\n    position: absolute;\r\n    left: 85px;\r\n}\r\n#nav-right-login-play{\r\n    position: absolute;\r\n    right: -45px;\r\n    top:16px;\r\n}\r\n\r\n\r\n/* Static Pages */\r\n.container-content-pages{\r\n    padding: 0 50px 40px 50px;\r\n    text-align: justify;\r\n}\r\n.container-content-pages .answer-container{\r\n    border: 2px solid lightgrey;\r\n    border-radius: 5px;\r\n    padding: 20px 40px;\r\n    margin: 5px 0;\r\n}\r\n.container-content-pages p{\r\n    margin-bottom: 20px;\r\n}\r\n.about-us-img{\r\n    width: 100%;\r\n    padding: 10px 50px;\r\n}\r\n.tech-img{\r\n    width: 100%;\r\n    padding: 0 60px;\r\n}\r\n.kid-certified{\r\n    text-align: center;\r\n    margin-top: 30px;\r\n    margin-bottom: 40px;\r\n}\r\n.kid-certified-img{\r\n    width: 150px;\r\n    margin-bottom: 40px;\r\n}\r\nimg[align=\"center\"] {\r\n    display: block;\r\n    margin: 0 auto !important;\r\n}\r\ndiv.about-us-bottom{\r\n    margin-top: 45px;\r\n    padding: 0 90px;\r\n}\r\n.privacy-headings{\r\n    margin-top: 25px;\r\n}\r\n.pages-green-headings{\r\n    color: #72C02C;\r\n    margin-bottom: 0;\r\n}\r\n.align-center{\r\n    text-align: center;\r\n}\r\n.img-align-center{\r\n    margin: 0 auto;\r\n}\r\n.big-heading{\r\n    font-size: 32px;\r\n    margin-bottom: 30px;\r\n}\r\nh1.big-heading-blue{\r\n    border-radius: 5px;\r\n    background-color: #34c2ff;\r\n    padding: 12px;\r\n    color: white;\r\n    margin: 0;\r\n    cursor: default;\r\n    margin-bottom: 20px;\r\n}\r\n@media all and (max-width: 992px){\r\n    h1.big-heading-blue{\r\n        font-size: 26px;\r\n    }\r\n}\r\n@media all and (max-width: 768px){\r\n    h1.big-heading-blue{\r\n        font-size: 20px;\r\n    }\r\n}\r\n@media all and (max-width: 768px){\r\n    h1.selected-package{\r\n        font-size: 14px;\r\n    }\r\n}\r\n.middle-heading{\r\n    font-size: 24px;\r\n}\r\n.questions-answers h3{\r\n    margin-bottom: 10px;\r\n}\r\n.question-links a{\r\n    color: #555;\r\n}\r\n.question-links a:hover{\r\n    text-decoration: none;\r\n    color: #72C02C;\r\n}\r\n.back-to-top {\r\n    cursor: pointer;\r\n}\r\n.back-to-top:hover{\r\n    text-decoration: none;\r\n}\r\n.mb15{\r\n    margin-bottom: 15px;\r\n}\r\nform.contact-us-form{\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 19px;\r\n    border: none;\r\n}\r\n.contact-us-form .select select,\r\n.contact-us-form .input input,\r\n.contact-us-form .checkbox,\r\n.contact-us-form .textarea textarea{\r\n    font-family: 'McLaren', cursive;\r\n    font-size: 17px;\r\n    font-weight: lighter;\r\n    color: grey;\r\n}\r\n#contact_us textarea{\r\n    max-width: 640px;\r\n}\r\nselect.contact-us-select{\r\n    padding: 0;\r\n}\r\n#main_questions,\r\n#billing,\r\n#unsubscribe,\r\n#tech,\r\n#bad_behaviour,\r\n#payment_email_section,\r\n#game_card_pin_section,\r\n#send_contact_us_form{\r\n    display: none;\r\n}\r\n#contact_us{\r\n    max-width: 700px;\r\n    margin: auto;\r\n}\r\n.error-text{\r\n    font-size: 18px;\r\n    font-weight: bold;\r\n    color: red;\r\n}\r\n.success-text{\r\n    font-size: 18px;\r\n    font-weight: bold;\r\n    color: #72C02C;\r\n}\r\n.tycoon-img img{\r\n    margin: 0 auto 25px;\r\n    display: block;\r\n    max-width: 100%;\r\n    height: auto;\r\n}\r\n.membership-parents img{\r\n    display: block;\r\n    max-width: 100%;\r\n    height: auto;\r\n}\r\n.video-container {\r\n    position: relative;\r\n    padding-bottom: 56.25%;\r\n    padding-top: 0;\r\n    margin-bottom: 50px;\r\n    height: 0;\r\n    overflow: hidden;\r\n}\r\n.video-container iframe, .video-container object, .video-container embed {\r\n    position:absolute;\r\n    top:0;\r\n    left:0;\r\n    width:100%;\r\n    height:100%;\r\n}\r\n.under-membership{\r\n    font-weight: bold;\r\n    margin-top: 10px;\r\n    cursor: default;\r\n}\r\n.under-membership p{\r\n    margin-bottom: 0;\r\n}\r\ndiv.payment-summary-block{\r\n    background-color: #e5f4fa;\r\n    border-radius: 5px;\r\n    font-family: \"Arial\", serif;\r\n    margin-top: 20px;\r\n    padding: 20px;\r\n}\r\ndiv.payment-summary-block p{\r\n    color: black;\r\n    margin: 6px 0 20px;\r\n}\r\n@media all and (min-width: 992px){\r\n    .things-img{\r\n        margin-top: 17px;\r\n    }\r\n}\r\n@media all and (max-width: 992px){\r\n    .things-img{\r\n        margin-top: 9px;\r\n    }\r\n}\r\n@media all and (min-width: 992px){\r\n    .main-row{\r\n        padding-left: 20px;\r\n        padding-right: 20px;\r\n    }\r\n}\r\n@media all and (max-width: 992px){\r\n    .main-row{\r\n        padding-left: 15px;\r\n        padding-right: 15px;\r\n    }\r\n}\r\n@media all and (min-width: 992px){\r\n    .label-container-pass{\r\n        margin-top: 15px;\r\n    }\r\n}\r\n@media all and (max-width: 992px){\r\n    #login-payment-form{\r\n        min-height: 548px;\r\n    }\r\n}\r\n@media all and (min-width: 992px){\r\n    #login-payment-form{\r\n        max-width: 396px;\r\n    }\r\n}\r\n#login-payment-form{\r\n    background-color: #e5f4fa;\r\n    border-radius: 10px;\r\n    padding: 15px;\r\n    margin: 0 auto;\r\n}\r\n#login-payment-form .login-payment-label{\r\n    font-family: 'Fredoka One', cursive;\r\n    color: #00528c;\r\n    font-size: 24px;\r\n    margin-bottom: 0;\r\n}\r\n#login-payment-form .login-payment-input{\r\n    font-size: 18px;\r\n    border: solid #29a1cc 3px;\r\n    border-radius: 10px;\r\n    background-color: #e0eaf2;\r\n    width: 100%;\r\n    padding: 5px 15px;\r\n}\r\nform#login-payment-form .remember-me-label{\r\n    color: #00528c;\r\n    font-size: 18px;\r\n    font-weight: 700;\r\n    margin-left: 10px;\r\n}\r\nform#login-payment-form .remember-me-label:hover{\r\n    text-decoration: underline;\r\n}\r\n#login-payment-form .remember-me-block{\r\n    position: relative;\r\n    margin-top: 20px;\r\n    height: 40px;\r\n}\r\n#login-payment-form .remember-me{\r\n    display: block;\r\n    position: absolute;\r\n    top: 2px;\r\n    left: 10px;\r\n    cursor: pointer;\r\n}\r\n#login-payment-form .blank-tick{\r\n    display: none;\r\n    width: 22px;\r\n    height: 22px;\r\n}\r\n#login-payment-form .hidden-tick{\r\n    display: none;\r\n    position: absolute;\r\n    top: 165px;\r\n    left: 40px;\r\n}\r\n#login-payment-form .remember-me-frame{\r\n    border: solid steelblue 3px;\r\n    border-radius: 5px;\r\n    background-color: lightgrey;\r\n    width: 30px;\r\n    height: 30px;\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n}\r\n.grey-container{\r\n    background-color: #f2f2f2;\r\n    border-radius: 10px;\r\n    min-height: 180px;\r\n    padding: 6px 12px;\r\n    margin-top: 30px;\r\n}\r\n.grey-container p{\r\n    padding-left: 10px;\r\n    cursor: default;\r\n    margin: 0;\r\n}\r\n.heading-blue{\r\n    border-radius: 10px;\r\n    background-color: #34c2ff;\r\n    padding: 6px 10px;\r\n    color: white;\r\n    cursor: default;\r\n    margin: 0;\r\n}\r\n.blue-text{\r\n    color: #34c2ff;\r\n}\r\n.blue-text:hover{\r\n    color: #34c2ff;\r\n    text-decoration: none;\r\n}\r\n.relative{\r\n    position: relative;\r\n}\r\n.grey-border-top{\r\n    border-top: solid 4px darkgrey;\r\n}\r\ndiv.for-letters{\r\n    max-width: 500px;\r\n}\r\ndiv.for-letters p{\r\n    color: black;\r\n    text-align: justify;\r\n}\r\n#game-card-form #pin,\r\n#game-card-form #email{\r\n    width: 100%;\r\n    margin-top: 10px;\r\n}\r\n#game-card-form #agree{\r\n    margin-top: 20px;\r\n}\r\n.membership-cards-title{\r\n    margin-bottom: 30px;\r\n    margin-top: 20px;\r\n}\r\n.star{\r\n    position: absolute;\r\n    z-index: 1;\r\n}\r\n.star-lg{\r\n    top: -30px;\r\n    right: -70px;\r\n}\r\n.star-md{\r\n    top: -36px;\r\n    right: -70px;\r\n}\r\n.star-sm{\r\n    top: -28px;\r\n    right: -53px;\r\n}\r\n.nav-arrow-membership{\r\n    left: 95px;\r\n}\r\n.nav-arrow-parents{\r\n    left: 400px;\r\n}\r\n.nav-arrow-help{\r\n    left: 535px;\r\n}\r\n.retailers-block{\r\n    background-color: lightgrey;\r\n    border-radius: 30px;\r\n    margin-bottom: 50px;\r\n}\r\n#loading{\r\n    display: none;\r\n    margin-top: 15px;\r\n}\r\n.paragraph{\r\n    margin-bottom: 30px;\r\n}\r\ndiv.paragraph p{\r\n    margin: 0;\r\n}\r\n.nav-right-play{\r\n    position: absolute;\r\n    top: 16px;\r\n    right: 25px;\r\n}\r\n.questions-titles{\r\n    margin: 40px 0 10px;\r\n}\r\n/*Home Page*/\r\n#bg-home-left-side{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/bg_left_side.png\");\r\n    left: -369px;\r\n}\r\n#bg-home-right-side{\r\n    background-image: url(\"https://play.binweevils.app/assets/img/blog/bg_right_side.png\");\r\n    right: -370px;\r\n}\r\n#container-content-home{\r\n    background: white;\r\n    position: relative;\r\n}\r\ndiv.container{\r\n    padding-left: 0;\r\n    padding-right: 0;\r\n}\r\n.home-play-btn{\r\n    position: relative;\r\n    top: -130px;\r\n}\r\n.logo-home{\r\n    left: 20px;\r\n}\r\n.nav-nest-home{\r\n    left: -50px;\r\n}\r\n.home-pull-up{\r\n    position: relative;\r\n    top: -80px;\r\n}\r\n#forgot_pass{\r\n    max-width: 700px;\r\n    margin: auto;\r\n}\r\n#forgot_pass textarea{\r\n    max-width: 640px;\r\n}\r\n#create_new_pass{\r\n    max-width: 700px;\r\n    margin: auto;\r\n}\r\n#create_new_pass textarea{\r\n    max-width: 640px;\r\n}\r\n.logged-in-container{\r\n    position: relative;\r\n    left: -75px;\r\n    width: 300px;\r\n}\r\n.logged-in-container-blog{\r\n    position: relative;\r\n    left: -10px;\r\n    width: 300px;\r\n}\r\n.home-blog-post-container{\r\n    padding: 10px 5px;\r\n    border: 2px solid lightgrey;\r\n    border-radius: 5px;\r\n    margin: 3px;\r\n}\r\n.latest-news{\r\n    font-family: \"Fredoka One\", cursive;\r\n    color: #FB9A13;\r\n    font-size: 23px;\r\n}\r\n.latest-news:hover{\r\n    text-transform: none;\r\n    cursor: pointer;\r\n}\r\n.intro-home{\r\n    margin-bottom: 65px;\r\n    font-family: \"McLaren\", cursive;\r\n}\r\n.home-bg{\r\n    background-color: #1282FF;\r\n}\r\n/*End of Home Page*/\r\n\r\n\r\nbody.stop-scrolling {\r\n  height: 100%;\r\n  overflow: hidden; }\r\n\r\n.sweet-overlay {\r\n  background-color: black;\r\n  /* IE8 */\r\n  -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=40)\";\r\n  /* IE8 */\r\n  background-color: rgba(0, 0, 0, 0.4);\r\n  position: fixed;\r\n  left: 0;\r\n  right: 0;\r\n  top: 0;\r\n  bottom: 0;\r\n  display: none;\r\n  z-index: 10000; }\r\n\r\n.sweet-alert {\r\n  background-color: white;\r\n  font-family: 'Open Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;\r\n  width: 478px;\r\n  padding: 17px;\r\n  border-radius: 5px;\r\n  text-align: center;\r\n  position: fixed;\r\n  left: 50%;\r\n  top: 50%;\r\n  margin-left: -256px;\r\n  margin-top: -200px;\r\n  overflow: hidden;\r\n  display: none;\r\n  z-index: 99999; }\r\n  @media all and (max-width: 540px) {\r\n    .sweet-alert {\r\n      width: auto;\r\n      margin-left: 0;\r\n      margin-right: 0;\r\n      left: 15px;\r\n      right: 15px; } }\r\n  .sweet-alert h2 {\r\n    color: #575757;\r\n    font-size: 30px;\r\n    text-align: center;\r\n    font-weight: 600;\r\n    text-transform: none;\r\n    position: relative;\r\n    margin: 25px 0;\r\n    padding: 0;\r\n    line-height: 40px;\r\n    display: block; }\r\n  .sweet-alert p {\r\n    color: #797979;\r\n    font-size: 16px;\r\n    text-align: center;\r\n    font-weight: 300;\r\n    position: relative;\r\n    text-align: inherit;\r\n    float: none;\r\n    margin: 0;\r\n    padding: 0;\r\n    line-height: normal; }\r\n  .sweet-alert fieldset {\r\n    border: none;\r\n    position: relative; }\r\n  .sweet-alert .sa-error-container {\r\n    background-color: #f1f1f1;\r\n    margin-left: -17px;\r\n    margin-right: -17px;\r\n    overflow: hidden;\r\n    padding: 0 10px;\r\n    max-height: 0;\r\n    webkit-transition: padding 0.15s, max-height 0.15s;\r\n    transition: padding 0.15s, max-height 0.15s; }\r\n    .sweet-alert .sa-error-container.show {\r\n      padding: 10px 0;\r\n      max-height: 100px;\r\n      webkit-transition: padding 0.2s, max-height 0.2s;\r\n      transition: padding 0.25s, max-height 0.25s; }\r\n    .sweet-alert .sa-error-container .icon {\r\n      display: inline-block;\r\n      width: 24px;\r\n      height: 24px;\r\n      border-radius: 50%;\r\n      background-color: #ea7d7d;\r\n      color: white;\r\n      line-height: 24px;\r\n      text-align: center;\r\n      margin-right: 3px; }\r\n    .sweet-alert .sa-error-container p {\r\n      display: inline-block; }\r\n  .sweet-alert .sa-input-error {\r\n    position: absolute;\r\n    top: 29px;\r\n    right: 26px;\r\n    width: 20px;\r\n    height: 20px;\r\n    opacity: 0;\r\n    -webkit-transform: scale(0.5);\r\n    transform: scale(0.5);\r\n    -webkit-transform-origin: 50% 50%;\r\n    transform-origin: 50% 50%;\r\n    -webkit-transition: all 0.1s;\r\n    transition: all 0.1s; }\r\n    .sweet-alert .sa-input-error::before, .sweet-alert .sa-input-error::after {\r\n      content: \"\";\r\n      width: 20px;\r\n      height: 6px;\r\n      background-color: #f06e57;\r\n      border-radius: 3px;\r\n      position: absolute;\r\n      top: 50%;\r\n      margin-top: -4px;\r\n      left: 50%;\r\n      margin-left: -9px; }\r\n    .sweet-alert .sa-input-error::before {\r\n      -webkit-transform: rotate(-45deg);\r\n      transform: rotate(-45deg); }\r\n    .sweet-alert .sa-input-error::after {\r\n      -webkit-transform: rotate(45deg);\r\n      transform: rotate(45deg); }\r\n    .sweet-alert .sa-input-error.show {\r\n      opacity: 1;\r\n      -webkit-transform: scale(1);\r\n      transform: scale(1); }\r\n  .sweet-alert input {\r\n    width: 100%;\r\n    box-sizing: border-box;\r\n    border-radius: 3px;\r\n    border: 1px solid #d7d7d7;\r\n    height: 43px;\r\n    margin-top: 10px;\r\n    margin-bottom: 17px;\r\n    font-size: 18px;\r\n    box-shadow: inset 0px 1px 1px rgba(0, 0, 0, 0.06);\r\n    padding: 0 12px;\r\n    display: none;\r\n    -webkit-transition: all 0.3s;\r\n    transition: all 0.3s; }\r\n    .sweet-alert input:focus {\r\n      outline: none;\r\n      box-shadow: 0px 0px 3px #c4e6f5;\r\n      border: 1px solid #b4dbed; }\r\n      .sweet-alert input:focus::-moz-placeholder {\r\n        transition: opacity 0.3s 0.03s ease;\r\n        opacity: 0.5; }\r\n      .sweet-alert input:focus:-ms-input-placeholder {\r\n        transition: opacity 0.3s 0.03s ease;\r\n        opacity: 0.5; }\r\n      .sweet-alert input:focus::-webkit-input-placeholder {\r\n        transition: opacity 0.3s 0.03s ease;\r\n        opacity: 0.5; }\r\n    .sweet-alert input::-moz-placeholder {\r\n      color: #bdbdbd; }\r\n    .sweet-alert input:-ms-input-placeholder {\r\n      color: #bdbdbd; }\r\n    .sweet-alert input::-webkit-input-placeholder {\r\n      color: #bdbdbd; }\r\n  .sweet-alert.show-input input {\r\n    display: block; }\r\n  .sweet-alert .sa-confirm-button-container {\r\n    display: inline-block;\r\n    position: relative; }\r\n  .sweet-alert .la-ball-fall {\r\n    position: absolute;\r\n    left: 50%;\r\n    top: 50%;\r\n    margin-left: -27px;\r\n    margin-top: 4px;\r\n    opacity: 0;\r\n    visibility: hidden; }\r\n  .sweet-alert button {\r\n    background-color: #8CD4F5;\r\n    color: white;\r\n    border: none;\r\n    box-shadow: none;\r\n    font-size: 17px;\r\n    font-weight: 500;\r\n    -webkit-border-radius: 4px;\r\n    border-radius: 5px;\r\n    padding: 10px 32px;\r\n    margin: 26px 5px 0 5px;\r\n    cursor: pointer; }\r\n    .sweet-alert button:focus {\r\n      outline: none;\r\n      box-shadow: 0 0 2px rgba(128, 179, 235, 0.5), inset 0 0 0