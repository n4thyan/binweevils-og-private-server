      "text": "/* CSS Document */\n\na{\n/*\tcolor:#008A00;*/\n\toutline: none;\n\ttext-decoration: none;\n}\n\n#container{\n/*\tposition:relative;*/\n/*\tmargin-left:auto;*/\n/*\tmargin-right:auto;*/\n/*\twidth:960px;*/\n\t/*border:1px solid #000000;*/\n\tmargin: 0 auto;\n    position: relative;\n    width: 960px;\n}\n\n#logo{\n    height: 66px;\n    left: 21px;\n    position: absolute;\n    top: -10px;\n    z-index: 1000;\n}\n\n#frameLeft{\n    position: absolute;\n    top: 111px;\n    z-index: 0;\n}\n\n#nav{\n\tposition:absolute;\n\tleft:140px;\n\ttop:0px;\n\theight:66px;\n\twidth:820px;\n\ttext-align:center; /* just centered for the comment to look better ! */\n\tz-index:5;\n}\n\n#flash{\n\tposition:relative;\n\ttop:66px;\n\tleft:20px;\n\theight:630px;\n\twidth:940px;\n\t/*border:1px solid #FF0000;*/\n/*\tz-index:999;*/\n}\n\n#flashRegister{\n\t/*position:absolute;\n\ttop:0px;\n\tleft:20px;\n\theight:720px;\n\twidth:1024px;\n\t/*border:1px solid #FF0000;\n\tz-index:999;*/\n\tfloat: left;\n}\n\n#footer{\n/*\tmargin-left:120px;*/\n\n\ttext-align:center;\n/*\tpadding-top:800px;\t*/\n}\n\n#affiliateheader{\n\tpadding-bottom:10px;\n}\n\n#affiliatefooter{\n\tmargin-top:10px;\n}\n\n/*\nCopied css from www/css/style.css\n*/\n\n.maindiv{\n\twidth:100%;\n\tfloat:left;\n}\n\n.maincenter{\n\twidth:926px;\n\tmargin-left:auto;\n\tmargin-right:auto;\n}\n\n.maindiv{\n\twidth:100%;\n\tfloat:left;\n}\n\n.menu2{\n\theight:62px;\n\tpadding-left:82px;\n\twidth:844px;\n\tfloat:left;\n\tbackground-image:url(../images/contenttop.html);\n\tbackground-position:0px 32px;\n\tbackground-repeat:no-repeat;\n}\n\n.content{\n\tbackground-image:url(../images/contentbg.html);\n\tbackground-repeat:repeat-y;\n\tpadding-bottom:100px;\n\tfloat: left;\n}\n\n.contentbottom{\n\theight:45px;\n\tbackground-image:url(../images/contentbottom.html);\n\tposition:relative;\n}\n\n.bottomct{\n\tposition:absolute;\n\ttop:-92px;\n\tleft:-42px;\n}\n\n.footerbg{\n\twidth:785px;\n\theight:58px;\n\tpadding-left:76px;\n\tbackground-position:76px 0px;\n\tbackground-image:url(../images/footerbg.html);\n\tbackground-repeat:no-repeat;\n\tfloat:left;\n}\n\n.Regcontainer {\n\twidth: 854px;\n\ttext-align: center;\n\tbackground-color: #FFFFFF;\n\tmargin-left: 43px;\n\tposition: inherit;\n}\n\n#mainTable {\n    width: 650px;\n    margin: 0 auto 0 auto;\n    border-collapse: collapse;\n}\n\n#mainTable td {\n    margin: 0;\n    padding: 10px 5px;\n    vertical-align: middle;\n    text-align: left;\n}\n\n#mainTable p {\n    text-align: justify;\n    line-height: 1.3em;\n    font-size: 15px;\n    color: #000000;\n}\n\n#mainTable h3 {\n    font-size: 20px;\n    font-weight: bold;\n    text-align: center;\n    color: #000000;\n}\n\n.txtyellow{\n\tcolor:#fdfd8b;\n}"
