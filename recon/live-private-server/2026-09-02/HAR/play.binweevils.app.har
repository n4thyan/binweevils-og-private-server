     "content": {
      "size": 4811,
      "mimeType": "text/html",
      "text": "<!DOCTYPE html>\n<!--[if IE 8]>\n<html lang=\"en\" class=\"ie8\"> <![endif]-->\n<!--[if IE 9]>\n<html lang=\"en\" class=\"ie9\"> <![endif]-->\n<!--[if !IE]><!-->\n<html lang=\"en\"> <!--<![endif]-->\n<head>\n    <title>404 | Bin Weevils Rewritten</title>\n    <meta content=\"https://binweevils.app/assetsHome/images/logo2.png?ver=1\" property=\"og:image\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link href=\"../assets/images/weevil.png\" rel=\"shortcut icon\" type=\"image/x-icon\">\n    <meta content=\"../assets/images/logo.png\" property=\"og:image\">\n    <meta content=\"Bin Weevils Rewritten - The newly and improved Bin Weevils. Design nest rooms, grow a garden, chat with friends, become a Secret Agent, crack puzzles, play games, train pets, enter competitions and more!\" name=\"description\">\n    <meta content=\"games, free online games, games, kids games, racing games, multiplayer games, maths games, virtual pets, pets, competitions, videos, bin, weevils, wivles, benwivles, bin weevils, bin weevils rewritten, bwr, bwrewritten, binweevils\" name=\"keywords\">\n    <meta content=\"#22b305\" name=\"theme-color\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://fonts.googleapis.com/css?family=Open+Sans:400,300,600&amp;subset=cyrillic,latin\">\n    <link href=\"https://fonts.googleapis.com/css?family=Nunito:400,700\" rel=\"stylesheet\" type=\"text/css\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://news.binweevils.app/assets/css/blog.css?ver=1\">\n    <link href=\"https://fonts.googleapis.com/css?family=McLaren\" rel=\"stylesheet\" type=\"text/css\">\n    <link href=\"https://fonts.googleapis.com/css?family=Fredoka+One\" rel=\"stylesheet\" type=\"text/css\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css\" integrity=\"sha512-...\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\n    <link rel=\"shortcut icon\" href=\"../icon.ico\">\n</head>\n\n<body>\n\n<div class=\"wrapper\">\n\n    <div class=\"container\" id =\"container-header\">\n        <!--=== Header ===-->\n        <div class=\"header\">\n            <div class=\"row nav-bar\">\n                <div class=\"col-md-2 col-sm-2 col-xs-2\">\n                    <a class=\"logo\" href=\"https://binweevils.app/\">\n                        <img src=\"/assetsHome/images/logo2.png\" alt=\"\" />\n                    </a>\n                </div>\n                <div class=\"col-xs-10\"></div>\n            </div>\n\n        </div>\n        <!--=== End Header ===-->\n    </div>\n\n    <!--=== Content Part ===-->\n    <div class=\"under-container-content\">\n        <div class=\"container white-content\" id=\"container-content\">\n            <a href=\"https://binweevils.app/\">\n                <img class=\"img-responsive img-align-center\" src=\"/assets/images/404.png\" alt=\"\">\n            </a>\n        </div>\n    </div>\n    <!--=== End Content Part ===-->\n\t<!--=== Footer ===-->\n        <input type=\"hidden\" id=\"current_url\" value=\"aHR0cDovL25ld3MuYmlud2Vldmlscy5jb20=\">\n        <div class=\"footer-v1\">\n            <div class=\"footer\">\n                <div class=\"container\">\n                    <div class=\"row\">\n                        <div id=\"footer-links\" class=\"col-sm-8 col-xs-12\">\n                            <ul class=\"list-unstyled \" style=\"float: left;\">\n                                <li><a href=\"/about/\">About Us</a></li>\n                                <li><a class=\"separator\">|</a></li>\n                                <li><a href=\"/legal/\">Terms & Conditions</a></li>\n                                <li><a class=\"separator\">|</a></li>\n                                <li><a href=\"/privacy/\">Privacy Policy</a></li>\n                                <li><a class=\"separator\">|</a></li>\n                                <li><a href=\"https://x.com/BWRewritten\"