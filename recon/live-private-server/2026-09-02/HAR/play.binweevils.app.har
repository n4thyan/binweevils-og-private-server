 library: http://www.dynamicdrive.com.\n//** Available/ usage terms at http://www.dynamicdrive.com (March 30th, 09')\n//** v1.1 (April 7th, 09'):\n//** 1) Adds ability to scroll to an absolute position (from top of page) or specific element on the page instead.\n//** 2) Fixes scroll animation not working in Opera.\n\n\nvar scrolltotop = {\n    //startline: Integer. Number of pixels from top of doc scrollbar is scrolled before showing control\n    //scrollto: Keyword (Integer, or \"Scroll_to_Element_ID\"). How far to scroll document up when control is clicked on (0=top).\n    setting: {startline: 100, scrollto: 0, scrollduration: 1000, fadeduration: [500, 100]},\n    controlHTML: '', //<img src=\"assets/img/up.png\" style=\"width:51px; height:42px\" /> //HTML for control, which is auto wrapped in DIV w/ ID=\"topcontrol\"\n    controlattrs: {offsetx: 5, offsety: 5}, //offset of control relative to right/ bottom of window corner\n    anchorkeyword: '#top', //Enter href value of HTML anchors on the page that should also act as \"Scroll Up\" links\n\n    state: {isvisible: false, shouldvisible: false},\n\n    scrollup: function () {\n        if (!this.cssfixedsupport) //if control is positioned using JavaScript\n            this.$control.css({opacity: 0}); //hide control immediately after clicking it\n        var dest = isNaN(this.setting.scrollto) ? this.setting.scrollto : parseInt(this.setting.scrollto);\n        if (typeof dest == \"string\" && jQuery('#' + dest).length == 1) //check element set by string exists\n            dest = jQuery('#' + dest).offset().top;\n        else\n            dest = 0;\n        this.$body.animate({scrollTop: dest}, this.setting.scrollduration);\n    },\n\n    keepfixed: function () {\n        var $window = jQuery(window);\n        var controlx = $window.scrollLeft() + $window.width() - this.$control.width() - this.controlattrs.offsetx;\n        var controly = $window.scrollTop() + $window.height() - this.$control.height() - this.controlattrs.offsety;\n        this.$control.css({left: controlx + 'px', top: controly + 'px'});\n    },\n\n    togglecontrol: function () {\n        var scrolltop = jQuery(window).scrollTop();\n        if (!this.cssfixedsupport)\n            this.keepfixed();\n        this.state.shouldvisible = (scrolltop >= this.setting.startline);\n        if (this.state.shouldvisible && !this.state.isvisible) {\n            this.$control.stop().animate({opacity: 1}, this.setting.fadeduration[0]);\n            this.state.isvisible = true\n        }\n        else if (this.state.shouldvisible == false && this.state.isvisible) {\n            this.$control.stop().animate({opacity: 0}, this.setting.fadeduration[1]);\n            this.state.isvisible = false\n        }\n    },\n\n    init: function () {\n        jQuery(document).ready(function ($) {\n            var mainobj = scrolltotop;\n            var iebrws = document.all;\n            mainobj.cssfixedsupport = !iebrws || iebrws && document.compatMode == \"CSS1Compat\" && window.XMLHttpRequest //not IE or IE7+ browsers in standards mode\n            mainobj.$body = (window.opera) ? (document.compatMode == \"CSS1Compat\" ? $('html') : $('body')) : $('html,body')\n            mainobj.$control = $('<div id=\"topcontrol\">' + mainobj.controlHTML + '</div>')\n                .css({\n                    position: mainobj.cssfixedsupport ? 'fixed' : 'absolute',\n                    bottom: mainobj.controlattrs.offsety,\n                    right: mainobj.controlattrs.offsetx,\n                    opacity: 0,\n                    cursor: 'pointer'\n                })\n                .attr({title: 'Scroll Back to Top'})\n                .click(function () {\n                    mainobj.scrollup();\n                    return false\n                })\n                .appendTo('body');\n            if (document.all && !window.XMLHttpRequest && mainobj.$control.text() != '') //loose check for IE6 and below, plus whether control contains any text\n                mainobj.$control.css({width: mainobj.$control.width()}) //IE6- seems to require an explicit width on a DIV containing text\n            mainobj.togglecontrol();\n            $('a[href=\"' + mainobj.anchorkeyword + '\"]').click(function () {\n                mainobj.scrollup();\n                return false\n            });\n            $(window).bind('scroll resize', function (e) {\n                mainobj.togglecontrol()\n            })\n        })\n    }\n};\n\nscrolltotop.init();\n/* Write here your custom javascript codes */\n\n(function($) {\n\n    //mini-menu rollover\n    $(\"img.img-hover\").hover(\n        function() {\n            $(this).data(\"img-original\", $(this).attr(\"src\"));\n            $(this).attr(\"src\", $(this).data(\"img-over\"));\n        }, function() {\n            $(this).attr(\"src\", $(this).data(\"img-original\"));\n        }\n    );\n\n})(jQuery);\n\n(function($) {\n\n    //toggle menu - menu/close\n    $(\".toggle-menu-img\").toggle(\n        function() {\n            $(this).attr('src','/assets/img/binweevils/toggle-menu/close1.png');\n            $(\".toggle-menu\").show('slow');\n        },\n        function() {\n            $(this).attr('src','/assets/img/binweevils/toggle-menu/menu1.png');\n            $(\".toggle-menu\").hide('slow');\n        }\n    );\n\n})(jQuery);\n\nfunction buyItemFromBlog(itemTypeID, storeName, colour, itemTypeIDfree, colourFree) {\n\n    swal({\n            title: \"Confirm Purchase\",\n            text: \"Are you sure you'd like to purchase this item?\",\n            type: \"info\",\n            showCancelButton: true,\n            cancelButtonText: \"No\",\n            confirmButtonText: \"Yes\",\n            closeOnConfirm: false,\n            showLoaderOnConfirm: true\n        },\n        function () {\n            $.ajax({\n                url: 'http://news.binweevils.com/ajax/buy-item-from-blog',\n                method: \"POST\",\n                data: {\n                    itemTypeID: itemTypeID,\n                    storeName: storeName,\n                    colour: colour,\n                    timer: 1900624,\n                    hash: \"3d69729e0f78b16bc9def85f0253dd3f\",\n                    itemTypeIDfree: itemTypeIDfree || \"\",\n                    colourFree: colourFree || \"\"\n                },\n                success: function (data) {\n                    handleResponseCode(data, itemTypeID, storeName, colour, itemTypeIDfree, colourFree);\n                }\n            });\n        });\n\n}\n\nfunction buyItemFromBlogWithVoucher(itemTypeID, storeName, colour, itemTypeIDfree, colourFree, useVoucher) {\n\n    $.ajax({\n        url: 'http://news.binweevils.com/ajax/buy-item-from-blog',\n        method: \"POST\",\n        data: {\n            itemTypeID: itemTypeID,\n            storeName: storeName,\n            colour: colour,\n            timer: 1900624,\n            hash: \"3d69729e0f78b16bc9def85f0253dd3f\",\n            itemTypeIDfree: itemTypeIDfree || \"\",\n            colourFree: colourFree || \"\",\n            useVoucher: useVoucher\n        },\n        success: function (data) {\n            handleResponseCode(data, itemTypeID, storeName, colour, itemTypeIDfree, colourFree, useVoucher);\n        }\n    });\n}\n\nfunction handleResponseCode(data, itemTypeID, storeName, colour, itemTypeIDfree, colourFree, useVoucher) {\n    if (data.responseCode == 1) { //success\n        swal({\n            title: \"Success!\",\n            text: \"You have successfully purchased this item!</br> Check your My Stuff Box.\",\n            type: \"success\",\n            html: true\n        });\n        return;\n    }\n    if (data.responseCode == 3) { //cannot afford\n        swal({\n            title: \"Uh-oh!\",\n            text: \"Sorry, you cannot afford this item.\",\n            type: \"warning\",\n            html: true\n        });\n        return;\n    }\n    if (data.responseCode == 4) { //no item found\n        swal({\n            title: \"Uh-oh!\",\n            text: \"The item you are trying to purchase is not available.\",\n            type: \"error\",\n            html: true,\n            closeOnConfirm: true\n        });\n        return;\n    }\n    if (data.responseCode == 7) { //tycoon only\n        swal({\n            title: \"Uh-oh!\",\n            text: \"Sorry, you need to be a Bin Tycoon Member</br> to purchase this item.\",\n            type: \"error\",\n            html: true,\n            closeOnConfirm: true\n        });\n        return;\n    }\n    if (data.responseCode == 8) { //need higher level\n        swal({\n            title: \"Uh-oh!\",\n            text: \"Sorry, your level is not high enough to make this purchase.\",\n            type: \"error\",\n            html: true,\n            closeOnConfirm: true\n        });\n        return;\n    }\n    if (data.responseCode == 9) { //not logged in\n        haveToLogInToBuyItemFromBlog();\n        return;\n    }\n    if (data.responseCode == 5) { //voucher is applicable and optional\n        swal({\n                title: \"You have Dosh vouchers!\",\n                text: \"You have earned <strong>\"+data.voucher_dosh+\" Dosh</strong> in vouchers!</br>Would you like to use it towards this purchase?\",\n                type: \"warning\",\n                showCancelButton: true,\n                confirmButtonColor: \"#69b22c\",\n                confirmButtonText: \"Yes\",\n                cancelButtonText: \"No\",\n                closeOnConfirm: false,\n                closeOnCancel: false,\n                showLoaderOnConfirm: true,\n                html: true\n            },\n            function(isConfirm){\n                if (isConfirm) {\n                    buyItemFromBlogWithVoucher(itemTypeID, storeName, colour, itemTypeIDfree, colourFree, 1);\n                } else {\n                    buyItemFromBlogWithVoucher(itemTypeID, storeName, colour, itemTypeIDfree, colourFree, 0);\n                }\n            });\n        return;\n    }\n    if (data.responseCode == 6) { //voucher is applicable and necessary\n        swal({\n                title: \"You have Dosh vouchers!\",\n                text: \"You do not have enough Dosh.</br>However, you have earned <strong>\"+data.voucher_dosh+\" Dosh</strong> in vouchers!</br>Would you like to use it towards this purchase?\",\n                type: \"warning\",\n                showCancelButton: true,\n                confirmButtonColor: \"#69b22c\",\n                confirmButtonText: \"Yes\",\n                cancelButtonText: \"No\",\n                closeOnConfirm: false,\n                closeOnCancel: false,\n                showLoaderOnConfirm: true,\n                html: true\n            },\n            function(isConfirm){\n                if (isConfirm) {\n                    buyItemFromBlogWithVoucher(itemTypeID, storeName, colour, itemTypeIDfree, colourFree, 1);\n                } else {\n                    swal(\"Cancelled\", \"Your purchase has been cancelled.\", \"warning\");\n                }\n            });\n        return;\n    }\n    swal({\n        title: \"Oops!</br>Something went wrong.\",\n        text: \"There was an error while trying to purchase the item.\",\n        type: \"error\",\n        html: true\n    });\n}\n\nfunction incorrectUsernameOrPass() {\n    swal({\n        title: \"Incorrect username or password\",\n        text: \"Please try again\",\n        type: \"error\",\n        html: true\n    });\n}\n\nfunction parentDisabled() {\n    swal({\n        title: \"Parent disabled\",\n        text: \"Your account has been disabled by parent\",\n        type: \"error\",\n        html: true\n    });\n}\n\nfunction somethingWrong(){\n    swal({\n        title: \"Oops\",\n        text: \"Something went wrong. Please try again.\",\n        type: \"error\",\n        html: true\n    });\n}\n/*\n * Template Name: Unify - Responsive Bootstrap Template\n * Description: Business, Corporate, Portfo