r/medium/nav-blog1.png\" data-img-over=\"https://cdn.binweevils.app/assets/img/blog/navbar/medium/nav-blog2.png\" alt=\"\"/>\r\n        </a>\r\n\r\n        <a href=\"/parents_overview\">\r\n            <img class=\"img-hover\" src=\"https://cdn.binweevils.app/assets/img/blog/navbar/medium/nav-parents1.png\" data-img-over=\"https://cdn.binweevils.app/assets/img/blog/navbar/medium/nav-parents2.png\" alt=\"\"/>\r\n        </a>\r\n\r\n        <a href=\"https://x.com/BWRewritten\" target=\"_blank\">\r\n            <img class=\"img-hover\" src=\"https://cdn.binweevils.app/assets/img/blog/navbar/medium/nav-help1.png\" data-img-over=\"https://cdn.binweevils.app/assets/img/blog/navbar/medium/nav-help2.png\" alt=\"\"/>\r\n        </a>\r\n    </div>\r\n</div>\t\t\t\t\t<div id=\"nav-right-login-play\">\r\n\t\t\t\t\t\t<div id=\"esi-block-login\"></div>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<!--=== Content Part ===-->\r\n\t\t<div class=\"central-container\" id=\"container-content-play\">\r\n\r\n\t\t\t<div>\r\n\t\t\t\t<!--SuperAwesome Leaderboard Ad Tag -->\r\n\t\t\t\t<img src=\"https://play.binweevils.app/assets/img/play/advertisement_frame.png\" alt=\"\" class=\"bg-super-awesome-10198\">\r\n\t\t\t\t<iframe src=\"https://play.binweevils.app/login/advertisement_frame_leaderboard.php\" frameborder=\"0\" class=\"super-awesome-10198\"></iframe>\r\n\r\n\t\t\t\t<img class=\"login-container\" src=\"https://play.binweevils.app/assets/img/play/mainContainerBG.png\" alt=\"\">\r\n\r\n\t\t\t\t<!--Guys -->\r\n\t\t\t\t<img class=\"img-guys\" src=\"https://play.binweevils.app/assets/img/play/Tink_Clott.png\" alt=\"\">\r\n\r\n\t\t\t\t<!--MPU Ad Tag -->\r\n\t\t\t\t<img src=\"https://play.binweevils.app/assets/img/play/advertisement_frame_2.png\" alt=\"\" class=\"bg-super-awesome-10199\">\r\n\t\t\t\t<iframe src=\"https://play.binweevils.app/login/advertisement_frame_mpu.php\" frameborder=\"0\" class=\"super-awesome-10199\"></iframe>\r\n\r\n\t\t\t\t<!--Create New Weevil -->\r\n\t\t\t\t<a href=\"/register\">\r\n\t\t\t\t\t<img class=\"new-player img-hover\" src=\"https://play.binweevils.app/assets/img/binweevils/membership/login/new_player_1.png\" alt=\"\" data-img-over=\"https://play.binweevils.app/assets/img/binweevils/membership/login/new_player_2.png\">\r\n\t\t\t\t</a>\r\n\r\n\t\t\t\t<!--Login Form -->\r\n\t\t\t\t<form id=\"login-play-form\" action=\"https://play.binweevils.app/login/login.php\" method=\"POST\">\r\n\r\n\t\t\t\t\t<input type=\"hidden\" name=\"redirect_url\" value=\"https://play.binweevils.app/game.php\">\r\n\r\n\t\t\t\t\t<!-- Logged In View Container -->\r\n\t\t\t\t\t<div id=\"loggedInView\" style=\"display: block; opacity: 1; transition: opacity 0.3s ease-in-out;\">\r\n\t\t\t\t\t\t<img class=\"img-responsive img-align-center\" alt=\"\" style=\"margin-bottom: 10px; max-width: 170px;\" src=\"https://play.binweevils.app/assets/img/binweevils/membership/login/returning_player.png\" />\r\n\r\n\t\t\t\t\t\t<div style=\"text-align: center; margin: 20px 0; font-size: 18px; font-weight: bold; color: #333;\">\r\n\t\t\t\t\t\t\tLogged in as:<br>\r\n\t\t\t\t\t\t\t<span style=\"color: #007bff; font-size: 24px;\">mrslim</span>\r\n\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t<!-- Login Button -->\r\n\t\t\t\t\t\t<a class=\"login-btn\" href=\"javascript:{}\" onclick=\"document.getElementById('login-play-form').submit();\">\r\n\t\t\t\t\t\t\t<img class=\"img-hover img-responsive img-align-center wait-onclick\" style=\"margin-top: 5px; max-width: 170px;\" src=\"https://play.binweevils.app/assets/img/binweevils/membership/login/login_1.png\" data-img-over=\"https://play.binweevils.app/assets/img/binweevils/membership/login/login_2.png\" alt=\"Login\" />\r\n\t\t\t\t\t\t</a>\r\n\r\n\t\t\t\t\t\t<!-- Login to Another Account Button -->\r\n\t\t\t\t\t\t<div style=\"text-align: center; margin-top: 15px;\">\r\n\t\t\t\t\t\t\t<a href=\"javascript:switchToLoginForm();\" style=\"color: #007bff; text-decoration: underline; font-size: 14px;\">\r\n\t\t\t\t\t\t\t\tSwitch\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<!-- Normal Login View Container -->\r\n\t\t\t\t\t<div id=\"loginFormView\" style=\"display: none; opacity: 1; transition: opacity 0.3s ease-in-out;\">\r\n\t\t\t\t\t\t<img class=\"img-responsive img-align-center\" alt=\"\" style=\"margin-bottom: 10px; max-width: 170px;\" src=\"https://play.binweevils.app/assets/img/binweevils/membership/login/returning_player.png\" />\r\n\r\n\t\t\t\t\t\t<div class=\"label-container-name\">\r\n\t\t\t\t\t\t\t<label class=\"login-payment-label\" for=\"userID\">Bin Weevil Name</label>\r\n\t\t\t\t\t\t\t<input class=\"name login-payment-input\" type=\"text\" name=\"userID\" id=\"userID\" value=\"mrslim\" required>\r\n\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t<div class=\"label-container-pass\">\r\n\t\t\t\t\t\t\t<label class=\"login-payment-label\" for=\"password\">Password</label>\r\n\t\t\t\t\t\t\t<input class=\"password login-payment-input\" type=\"password\" name=\"password\" id=\"password\" value=\"\" required>\r\n\t\t\t\t\t\t\t<div class=\"remember-me-block\">\r\n\t\t\t\t\t\t\t\t<a class=\"remember-me\" onclick=\"toggleTick(); return false;\">\r\n\t\t\t\t\t\t\t\t\t<img id=\"tick\" class=\"pull-left\" alt=\"\" src=\"https://play.binweevils.app/assets/img/binweevils/membership/login/tickbox1.png\">\r\n\t\t\t\t\t\t\t\t\t<p class=\"remember-me-label pull-left\">Remember me</p>\r\n\t\t\t\t\t\t\t\t\t<div class=\"blank-tick pull-right\"></div>\r\n\t\t\t\t\t\t\t\t</a>\r\n\r\n\t\t\t\t\t\t\t\t<div class=\"hidden-tick\">\r\n\t\t\t\t\t\t\t\t\t<label for=\"rememberMe\">\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" name=\"rememberMe\" id=\"rememberMe\" checked>\r\n\t\t\t\t\t\t\t\t\t</label>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t<!--<a class=\"remember-me-label forgotten-label\" href=\"https://www.binweevils.com/forgotpass\">\r\n                        Forgotten your password?\r\n                    </a>-->\r\n\r\n\t\t\t\t\t\t\t<input type=\"submit\" class=\"input-submit\" />\r\n\r\n\t\t\t\t\t\t\t<a class=\"login-btn\" href=\"javascript:{}\" onclick=\"document.getElementById('login-play-form').submit();\">\r\n\t\t\t\t\t\t\t\t<img class=\"img-hover img-responsive img-align-center wait-onclick\" style=\"margin-top: 5px; max-width: 170px;\" src=\"https://play.binweevils.app/assets/img/binweevils/membership/login/login_1.png\" data-img-over=\"https://play.binweevils.app/assets/img/binweevils/membership/login/login_2.png\" alt=\"\" />\r\n\t\t\t\t\t\t\t</a>\r\n\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<!-- Back Button -->\r\n\t\t\t\t\t\t\t\t<div style=\"text-align: center; margin-top: 5px;\">\r\n\t\t\t\t\t\t\t\t\t<a href=\"javascript:switchToLoggedInView();\" style=\"color: #007bff; text-decoration: underline; font-size: 14px;\">\r\n\t\t\t\t\t\t\t\t\t\tGo Back\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<input type=\"hidden\" name=\"form_token\" id=\"form_token\" value=\"aea58a7b633f2d75c0a6235a5ce65797\" />\r\n\r\n\t\t\t\t</form>\r\n\r\n\t\t\t\t<img class=\"grass\" src=\"https://binweevils.app/assets/login/images/Bottom_bushes.png\" alt=\"\">\r\n\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<!--/row-->\r\n\t</div>\r\n\t<!--/container-->\r\n\t<!--=== End Content Part ===-->\r\n\r\n\t<!--=== Footer ===-->\r\n\t\t<input type=\"hidden\" id=\"current_url\" value=\"aHR0cHM6Ly9wbGF5LmJpbndlZXZpbHMuYXBwL2luZGV4LnBocA==\">\r\n\t<div class=\"footer-v1\">\r\n\t\t<div class=\"footer\">\r\n\t\t\t<div class=\"container\">\r\n\t\t\t\t<div class=\"row\">\r\n\t\t\t\t\t<div id=\"footer-links\" class=\"col-sm-8 col-xs-12\">\r\n\t\t\t\t\t\t<ul class=\"list-unstyled \" style=\"float: left;\">\r\n\t\t\t\t\t\t\t<li><a href=\"https://play.binweevils.app/about/\">About Us</a></li>\r\n\t\t\t\t\t\t\t<li><a class=\"separator\">|</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"https://play.binweevils.app/legal/\">Terms & Conditions</a></li>\r