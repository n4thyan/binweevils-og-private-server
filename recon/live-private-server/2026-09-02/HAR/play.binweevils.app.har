ss({\r\n\t\t\t\topacity: '1'\r\n\t\t\t});\r\n\r\n\t\t\tloggedInView.stop(true, true).fadeOut(500, function () {\r\n\t\t\t\tloginFormView.stop(true, true).fadeIn(500);\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tfunction switchToLoggedInView() {\r\n\t\t\tvar loggedInView = $(\"#loggedInView\");\r\n\t\t\tvar loginFormView = $(\"#loginFormView\");\r\n\r\n\t\t\tloginFormView.stop(true, true).fadeOut(500, function () {\r\n\t\t\t\tloggedInView.stop(true, true).fadeIn(500);\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tfunction toggleTick() {\r\n\t\t\tvar rememberMe = $(\"#rememberMe\");\r\n\t\t\tvar checked = $(\"#rememberMe:checked\").length;\r\n\t\t\tvar tick = $(\"#tick\");\r\n\t\t\t$(\".blank-tick\").toggle();\r\n\r\n\t\t\tif (checked == 0) {\r\n\t\t\t\trememberMe.prop(\"checked\", \"checked\");\r\n\t\t\t\ttick.attr(\"src\", \"https://play.binweevils.app/assets/img/binweevils/membership/login/tickbox2.png\");\r\n\t\t\t} else {\r\n\t\t\t\trememberMe.prop(\"checked\", \"\");\r\n\t\t\t\ttick.attr(\"src\", \"https://play.binweevils.app/assets/img/binweevils/membership/login/tickbox1.png\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfunction toCreateNewAccountUseDesktopLaptop() {\r\n\t\t\tswal({\r\n\t\t\t\ttitle: \"Attention!\",\r\n\t\t\t\ttext: \"Please visit <strong>binweevils.com</strong></br> from a desktop or laptop computer</br> to create your very own Bin Weevils account!\",\r\n\t\t\t\ttype: \"warning\",\r\n\t\t\t\thtml: true\r\n\t\t\t});\r\n\t\t}\r\n\r\n\r\n\r\n\t\t\r\n\t\tfunction closeMaintenanceNotice() {\r\n\t\t\tdocument.getElementById('maintenanceNotice').style.display = 'none';\r\n\t\t}\r\n\t</script>\r\n\r\n\t<!--[if lt IE 9]>\r\n<script src=\"/js/blog-ie9.js\"></script>\r\n\r\n<![endif]-->\r\n<script type=\"text/javascript\">window.NREUM||(NREUM={});NREUM.info={\"beacon\":\"bam.eu01.nr-data.net\",\"licenseKey\":\"NRJS-e83c63debd3ac7e7e04\",\"applicationID\":\"498084743,498086596\",\"transactionName\":\"MhBSZQoZXEtZVhJZVwtaZUMRV1tWXFAeHkgNBQ==\",\"queueTime\":0,\"applicationTime\":4,\"atts\"