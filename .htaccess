# Map bare extensionless endpoints (what the SWF requests, e.g. /user, /session_start)
# to their .php files, matching the pattern already used in weevil/ and rewards/.
RewriteEngine On

# The original Flash clients request these historical extensionless/static paths.
# Route them to live server-backed data without modifying the SWFs.
RewriteRule ^site/server-time$ site/server-time.php [L,QSA]
RewriteRule ^nestNews/xml/uk/nestNews\.xml$ nestNews/feed.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
